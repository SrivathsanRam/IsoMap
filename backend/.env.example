APP_ENV=development
# Set this to production to use DATABASE_URL from .env.production while keeping development CORS and cookies.
# DATABASE_ENV=production
DATABASE_URL=host=localhost user=postgres password=postgres dbname=isomap port=5432 sslmode=disable TimeZone=Asia/Singapore
FRONTEND_ORIGINS=http://localhost:5173,https://iso-map.vercel.app
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-long-random-secret
# Preferred for automatic renewal of OneMap's three-day access tokens.
ONEMAP_API_EMAIL=your-onemap-account-email
ONEMAP_API_PASSWORD=your-onemap-account-password
# Optional static fallback. The server rejects an expired JWT.
ONEMAP_API_KEY=your-onemap-access-token
# GTFS_GRAPH_PATH=../gtfs/generated/singapore.graph
# GTFS_FEED_PATH=../gtfs/raw/singapore-gtfs.zip
# FOOTPATH_GRAPH_PATH=../gtfs/generated/singapore.walk
# FOOTPATH_FEED_PATH=../gtfs/raw/Footpath_Mar2026.zip
